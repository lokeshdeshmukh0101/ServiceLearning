# ─────────────────────────────────────────────────────────────────────────────
# KnowledgeHub Backend — Environment Template
# Copy this file, rename it to .env, then fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Get your free Gemini key at: https://aistudio.google.com/app/apikey
LLM_PROVIDER=GEMINI
LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-flash-lite-latest
# GEMINI_API_KEY is also accepted as a legacy alias for LLM_API_KEY.
# For an OpenAI-compatible endpoint, set LLM_PROVIDER=OPENAI_COMPATIBLE and configure:
# LLM_BASE_URL=https://api.example.com
LLM_BASE_URL=

EMBEDDING_MODEL=gemini-embedding-001

CORS_ORIGIN="http://localhost:3000"

AUTH_SECRET=dev
